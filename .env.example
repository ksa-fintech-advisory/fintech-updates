# Public site URL (canonical origin for metadata, sitemap, robots). Default in code: https://arab-fintech.com
# NEXT_PUBLIC_APP_URL=https://your-domain.com

# Optional: override public contact email for Footer + Contact mailto links. Default in code: m.alhoomaidi@gmail.com
# NEXT_PUBLIC_CONTACT_EMAIL=m.alhoomaidi@gmail.com

# Optional: override default WhatsApp for Footer + Contact (digits only, no +). Default in code: 967771511569
# NEXT_PUBLIC_WHATSAPP_E164=967771511569

# Optional: profile photo path (default public/avatars/MOHAMMED_ABDO.JPG)
# NEXT_PUBLIC_PROFILE_IMAGE_PATH=/avatars/MOHAMMED_ABDO.JPG

# --- SendGrid (contact form → email) ---
# API key from SendGrid (keep secret; never commit .env)
# SENDGRID_API_KEY=SG.xxx
#
# Verified sender email in SendGrid (Single Sender or domain authentication)
# SENDGRID_FROM_EMAIL=noreply@your-verified-domain.com
#
# Optional: inbox that receives contact form submissions (defaults to NEXT_PUBLIC_CONTACT_EMAIL or built-in default)
# CONTACT_FORM_TO_EMAIL=you@example.com
