# Firebase Configuration
# Get these values from your Firebase project settings
# https://console.firebase.google.com/

NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your-vapid-key

# Optional: WhatsApp icon/link (Footer + Contact). Digits only, no + (e.g. 966501234567)
# NEXT_PUBLIC_WHATSAPP_E164=

# Optional: profile photo path (default public/images/profile.jpg)
# NEXT_PUBLIC_PROFILE_IMAGE_PATH=/images/profile.jpg
